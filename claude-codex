#!/usr/bin/env bash
# claude-codex — Launch Claude Code via Claude Bridge (OpenAI/Codex)
# https://github.com/axdel/claude-bridge
#
# Usage:
#   claude-codex              # from any directory
#   claude-codex --debug      # verbose bridge logs
#   claude-codex -- -p opus   # pass flags to claude after --
set -eo pipefail

BRIDGE_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
PORT=$((9000 + RANDOM % 999))
BRIDGE_PID=""
LOG_LEVEL="${LOG_LEVEL:-WARNING}"

# The bridge's one runtime dependency (httpx[http2], the HTTP/2 data plane) lives in
# the project venv that `uv sync` provisions at ${BRIDGE_DIR}/.venv — the system
# python3 does not have it. Run every claude_bridge invocation through that
# interpreter, and fail loud with the fix if the venv is missing (D-RUNTIME-003).
BRIDGE_PY="${BRIDGE_DIR}/.venv/bin/python"
if [[ ! -x "$BRIDGE_PY" ]]; then
    echo "claude-codex: ${BRIDGE_DIR}/.venv not found — run 'uv sync' in ${BRIDGE_DIR} first." >&2
    exit 1
fi

# Parse our flags (before --)
CLAUDE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug) LOG_LEVEL="DEBUG"; shift ;;
        --)      shift; CLAUDE_ARGS=("$@"); break ;;
        *)       CLAUDE_ARGS+=("$1"); shift ;;
    esac
done

cleanup() {
    if [[ -n "$BRIDGE_PID" ]] && kill -0 "$BRIDGE_PID" 2>/dev/null; then
        echo ""
        echo "~~~ bridge stopped (pid $BRIDGE_PID) ~~~"
        kill "$BRIDGE_PID" 2>/dev/null
        wait "$BRIDGE_PID" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

# Start bridge in background
export PYTHONPATH="${BRIDGE_DIR}/src${PYTHONPATH:+:$PYTHONPATH}"
export LOG_LEVEL
# `-P` (safe path, Python 3.11+) drops the automatic prepend of the current
# directory to sys.path, so running claude-codex from an untrusted project dir
# cannot let a local `claude_bridge/__main__.py` shadow the real bridge and read
# the provider auth.json (search-path injection, CWE-427). Our own trusted src dir
# is still first on the explicit PYTHONPATH exported above.
# Bridge logs go to stderr at LOG_LEVEL (WARNING+ by default), so upstream timeouts
# and stalled-stream deaths are visible on the terminal without `--debug`; `--debug`
# raises the level to DEBUG. No `2>/dev/null` here — discarding the whole stream is
# what hid the 120s upstream deaths; INFO/DEBUG chatter is filtered by the log level.
"$BRIDGE_PY" -P -m claude_bridge --port "$PORT" --provider openai &
BRIDGE_PID=$!

# Wait for bridge to accept connections (max 3s)
for _ in $(seq 1 30); do
    if "$BRIDGE_PY" -P -c "import socket; s=socket.socket(); s.settimeout(0.1); s.connect(('127.0.0.1',$PORT)); s.close()" 2>/dev/null; then
        break
    fi
    sleep 0.1
done

# Abort if the bridge died during startup (e.g. the port was already bound):
# never hand Claude Code's prompts to whatever else may be listening on $PORT.
if ! kill -0 "$BRIDGE_PID" 2>/dev/null; then
    echo "claude-codex: bridge failed to start on 127.0.0.1:${PORT} (port busy?)." >&2
    exit 1
fi

cat <<'BANNER'

      _                 _                         _
  ___| | __ _ _   _  __| | ___       ___ ___   __| | _____  __
 / __| |/ _` | | | |/ _` |/ _ \ ___ / __/ _ \ / _` |/ _ \ \/ /
| (__| | (_| | |_| | (_| |  __/|___||(_| (_) | (_| |  __/>  <
 \___|_|\__,_|\__,_|\__,_|\___|     \___\___/ \__,_|\___/_/\_\

BANNER
BRIDGE_VERSION=$("$BRIDGE_PY" -P -c "from claude_bridge import __version__; print(__version__)" 2>/dev/null || echo "?")
echo " port:${PORT}  pid:${BRIDGE_PID}  model:gpt-5.6-sol  version:${BRIDGE_VERSION}"
echo " by axdel  github.com/axdel/claude-bridge"
echo ""

# Run claude with bridge env
(
    export ANTHROPIC_BASE_URL="http://127.0.0.1:${PORT}"
    export ANTHROPIC_AUTH_TOKEN=bridge-placeholder
    # Tell Claude Code the backing model has a 300k-token window (well within GPT-5.6's
    # real context) so it defers auto-compaction and uses more context per session.
    export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-300000}"
    unset ANTHROPIC_API_KEY
    claude ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
)
