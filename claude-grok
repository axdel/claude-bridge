#!/usr/bin/env bash
# claude-grok — Launch Claude Code via Claude Bridge (xAI/Grok)
# https://github.com/axdel/claude-bridge
#
# Usage:
#   claude-grok              # from any directory
#   claude-grok --debug      # verbose bridge logs
#   claude-grok -- -p opus   # pass flags to claude after --
set -eo pipefail

BRIDGE_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
PORT=$((9000 + RANDOM % 999))
BRIDGE_PID=""
LOG_LEVEL="${LOG_LEVEL:-WARNING}"

# The bridge's one runtime dependency (httpx[http2], the HTTP/2 data plane) lives in
# the project venv that `uv sync` provisions at ${BRIDGE_DIR}/.venv — the system
# python3 does not have it. Run every claude_bridge invocation through that
# interpreter, and fail loud with the fix if the venv is missing (D-RUNTIME-003).
BRIDGE_PY="${BRIDGE_DIR}/.venv/bin/python"
if [[ ! -x "$BRIDGE_PY" ]]; then
    echo "claude-grok: ${BRIDGE_DIR}/.venv not found — run 'uv sync' in ${BRIDGE_DIR} first." >&2
    exit 1
fi

# Parse our flags (before --)
CLAUDE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug) LOG_LEVEL="DEBUG"; shift ;;
        --)      shift; CLAUDE_ARGS+=("$@"); break ;;
        *)       CLAUDE_ARGS+=("$1"); shift ;;
    esac
done

cleanup() {
    if [[ -n "$BRIDGE_PID" ]] && kill -0 "$BRIDGE_PID" 2>/dev/null; then
        echo ""
        echo "~~~ bridge stopped (pid $BRIDGE_PID) ~~~"
        kill "$BRIDGE_PID" 2>/dev/null
        wait "$BRIDGE_PID" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

# Start bridge in background
export LOG_LEVEL
# `-I` (isolated mode, Python 3.11+) starts the bridge with NO untrusted path on
# sys.path: it drops the current-directory prepend (like `-P`) AND ignores
# PYTHONPATH/PYTHONHOME AND the per-user site dir. `claude_bridge` resolves from the
# venv's editable install (the trusted ${BRIDGE_DIR}/src) and `httpx` from the venv
# site-packages, so running claude-grok from an untrusted project dir cannot let a
# local `sitecustomize.py`, `claude_bridge/`, or a shadowing `httpx.py` run ahead of
# the real bridge and read ~/.grok/auth.json (search-path injection, CWE-427). `-P`
# alone did NOT close this — it leaves an inherited PYTHONPATH (e.g. `.`) on the path,
# and httpx, not in src, would resolve from it. The venv is selected by the
# interpreter path, not env, so `-I` keeps it; LOG_LEVEL and the ANTHROPIC_* vars
# below are not PYTHON* vars, so `-I` honors them too.
# Bridge logs go to stderr at LOG_LEVEL (WARNING+ by default), so upstream timeouts
# and stalled-stream deaths are visible on the terminal without `--debug`; `--debug`
# raises the level to DEBUG. No `2>/dev/null` here — discarding the whole stream is
# what hid the 120s upstream deaths; INFO/DEBUG chatter is filtered by the log level
# instead, so the terminal stays quiet in normal use but never silent on failure.
"$BRIDGE_PY" -I -m claude_bridge --port "$PORT" --provider xai &
BRIDGE_PID=$!

# Wait for bridge to accept connections (max 3s)
for _ in $(seq 1 30); do
    if "$BRIDGE_PY" -I -c "import socket; s=socket.socket(); s.settimeout(0.1); s.connect(('127.0.0.1',$PORT)); s.close()" 2>/dev/null; then
        break
    fi
    sleep 0.1
done

# Abort if the bridge died during startup (e.g. the port was already bound):
# never hand Claude Code's prompts to whatever else may be listening on $PORT.
if ! kill -0 "$BRIDGE_PID" 2>/dev/null; then
    echo "claude-grok: bridge failed to start on 127.0.0.1:${PORT} (port busy?)." >&2
    exit 1
fi

cat <<'BANNER'

      _                 _                            _
  ___| | __ _ _   _  __| | ___        __ _ _ __ ___ | | __
 / __| |/ _` | | | |/ _` |/ _ \_____ / _` | '__/ _ \| |/ /
| (__| | (_| | |_| | (_| |  __/_____| (_| | | | (_) |   <
 \___|_|\__,_|\__,_|\__,_|\___|      \__, |_|  \___/|_|\_\
                                     |___/
BANNER
BRIDGE_VERSION=$("$BRIDGE_PY" -I -c "from claude_bridge import __version__; print(__version__)" 2>/dev/null || echo "?")
# Derive the model from the config owner (config.xai_model) rather than hardcoding it,
# so the banner tracks DEFAULT_XAI_MODEL and any XAI_MODEL override instead of drifting.
BRIDGE_MODEL=$("$BRIDGE_PY" -I -c "from claude_bridge import config; print(config.xai_model())" 2>/dev/null || echo "?")
echo " port:${PORT}  pid:${BRIDGE_PID}  model:${BRIDGE_MODEL}  version:${BRIDGE_VERSION}"
echo " by axdel  github.com/axdel/claude-bridge"
echo ""

# Run claude with bridge env
(
    export ANTHROPIC_BASE_URL="http://127.0.0.1:${PORT}"
    export ANTHROPIC_AUTH_TOKEN=bridge-placeholder
    # CLAUDE_CODE_MAX_CONTEXT_TOKENS is deliberately NOT set here. It is a Claude Code
    # env var this bridge never reads, so the harness installer owns it globally for
    # every session kind. Setting it here as well made this the second writer, and the
    # lower of the two silently won: peers compacted at the launcher's window, not the
    # harness cap. grok-4.6's 500K is the floor that sizes the harness value.
    # See D-CONTEXT-002.
    unset ANTHROPIC_API_KEY
    claude ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
)
