#!/usr/bin/env bash
# claude-grok — Launch Claude Code via Claude Bridge (xAI/Grok)
# https://github.com/axdel/claude-bridge
#
# Usage:
#   claude-grok              # from any directory
#   claude-grok --debug      # verbose bridge logs
#   claude-grok -- -p opus   # pass flags to claude after --
set -eo pipefail

BRIDGE_DIR="$(cd "$(dirname "$(readlink -f "$0" 2>/dev/null || echo "$0")")" && pwd)"
PORT=$((9000 + RANDOM % 999))
BRIDGE_PID=""
LOG_LEVEL="${LOG_LEVEL:-INFO}"

# Parse our flags (before --)
CLAUDE_ARGS=()
while [[ $# -gt 0 ]]; do
    case "$1" in
        --debug) LOG_LEVEL="DEBUG"; shift ;;
        --)      shift; CLAUDE_ARGS=("$@"); break ;;
        *)       CLAUDE_ARGS+=("$1"); shift ;;
    esac
done

cleanup() {
    if [[ -n "$BRIDGE_PID" ]] && kill -0 "$BRIDGE_PID" 2>/dev/null; then
        echo ""
        echo "~~~ bridge stopped (pid $BRIDGE_PID) ~~~"
        kill "$BRIDGE_PID" 2>/dev/null
        wait "$BRIDGE_PID" 2>/dev/null
    fi
}
trap cleanup EXIT INT TERM

# Start bridge in background
export PYTHONPATH="${BRIDGE_DIR}/src${PYTHONPATH:+:$PYTHONPATH}"
export LOG_LEVEL
# `-P` (safe path, Python 3.11+) drops the automatic prepend of the current
# directory to sys.path, so running claude-grok from an untrusted project dir
# cannot let a local `claude_bridge/__main__.py` shadow the real bridge and read
# ~/.grok/auth.json (search-path injection, CWE-427). Our own trusted src dir is
# still first on the explicit PYTHONPATH exported above.
# In debug mode surface bridge logs on the terminal; otherwise stay quiet.
# Without this the advertised `--debug` (LOG_LEVEL=DEBUG) would be a no-op —
# every log line went to /dev/null, leaving no way to diagnose auth/refresh/
# version-gate/stream failures.
if [[ "$LOG_LEVEL" == "DEBUG" ]]; then
    python3 -P -m claude_bridge --port "$PORT" --provider xai &
else
    python3 -P -m claude_bridge --port "$PORT" --provider xai 2>/dev/null &
fi
BRIDGE_PID=$!

# Wait for bridge to accept connections (max 3s)
for _ in $(seq 1 30); do
    if python3 -P -c "import socket; s=socket.socket(); s.settimeout(0.1); s.connect(('127.0.0.1',$PORT)); s.close()" 2>/dev/null; then
        break
    fi
    sleep 0.1
done

# Abort if the bridge died during startup (e.g. the port was already bound):
# never hand Claude Code's prompts to whatever else may be listening on $PORT.
if ! kill -0 "$BRIDGE_PID" 2>/dev/null; then
    echo "claude-grok: bridge failed to start on 127.0.0.1:${PORT} (port busy?)." >&2
    exit 1
fi

cat <<'BANNER'

      _                 _                            _
  ___| | __ _ _   _  __| | ___        __ _ _ __ ___ | | __
 / __| |/ _` | | | |/ _` |/ _ \_____ / _` | '__/ _ \| |/ /
| (__| | (_| | |_| | (_| |  __/_____| (_| | | | (_) |   <
 \___|_|\__,_|\__,_|\__,_|\___|      \__, |_|  \___/|_|\_\
                                     |___/
BANNER
BRIDGE_VERSION=$(python3 -P -c "from claude_bridge import __version__; print(__version__)" 2>/dev/null || echo "?")
# Derive the model from the config owner (config.xai_model) rather than hardcoding it,
# so the banner tracks DEFAULT_XAI_MODEL and any XAI_MODEL override instead of drifting.
BRIDGE_MODEL=$(python3 -P -c "from claude_bridge import config; print(config.xai_model())" 2>/dev/null || echo "?")
echo " port:${PORT}  pid:${BRIDGE_PID}  model:${BRIDGE_MODEL}  version:${BRIDGE_VERSION}"
echo " by axdel  github.com/axdel/claude-bridge"
echo ""

# Run claude with bridge env
(
    export ANTHROPIC_BASE_URL="http://127.0.0.1:${PORT}"
    export ANTHROPIC_AUTH_TOKEN=bridge-placeholder
    # Tell Claude Code the backing model has a 300k-token window (well within
    # grok-4.6's 500K context) so it defers auto-compaction and uses more context per session.
    export CLAUDE_CODE_MAX_CONTEXT_TOKENS="${CLAUDE_CODE_MAX_CONTEXT_TOKENS:-300000}"
    unset ANTHROPIC_API_KEY
    claude ${CLAUDE_ARGS[@]+"${CLAUDE_ARGS[@]}"}
)
